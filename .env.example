# =============================================================================
# MSSQL & DOCKER VERİTABANI AYARLARI (ZORUNLU)
# =============================================================================
# Docker üzerindeki SQL Server 'sa' kullanıcısının şifresi.
# En az 8 karakter, büyük harf, küçük harf, rakam ve sembol içermelidir (Örn: GucluSifre!2026).
MSSQL_SA_PASSWORD=BURAYA_GUCLU_MSSQL_SIFRENIZI_YAZIN

# .NET Backend'in MSSQL veritabanına bağlanacağı bağlantı dizesi.
# Yukarıda belirlediğiniz şifreyi 'Password=' kısmına da birebir yazmalısınız.
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=EBookDb;User Id=sa;Password=BURAYA_YUKARIDAKI_MSSQL_SIFRENIZI_YAZIN;TrustServerCertificate=True;MultipleActiveResultSets=True"

# =============================================================================
# SUPABASE KİMLİK DOĞRULAMA AYARLARI (OPSİYONEL - BONUS ÖZELLİK)
# =============================================================================
# Supabase kullanmayacaksanız bu alanları değiştirmeden bırakabilirsiniz (Sistem Misafir Modunda çalışır).
# Kullanmak isterseniz Supabase panelinizden (Project Settings -> API) aldığınız bilgileri girin:
Supabase__ProjectUrl=https://BURAYA_SUPABASE_PROJECT_ID_YAZIN.supabase.co
Supabase__Authority=https://BURAYA_SUPABASE_PROJECT_ID_YAZIN.supabase.co/auth/v1
Supabase__Audience=authenticated