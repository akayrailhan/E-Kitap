# =============================================================================
# FRONTEND ORTAM DEĞİŞKENLERİ (OPSİYONEL - SUPABASE AUTH)
# =============================================================================
# Bu değişkenler tanımlanmazsa uygulama doğrudan kesintisiz "Misafir Modu"nda çalışır.
# Kendi Supabase projenizle kayıt/giriş ve "Kitaplarım" geçmişini aktif etmek isterseniz:
# Supabase panelinizden (Project Settings -> API) aldığınız değerleri buraya yazın.

# Supabase Proje URL'iniz (Örn: https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=https://BURAYA_SUPABASE_PROJECT_ID_YAZIN.supabase.co

# Supabase Anon / Public API Anahtarınız (eyJhbGciOi...)
VITE_SUPABASE_ANON_KEY=BURAYA_SUPABASE_ANON_PUBLIC_KEY_YAZIN
